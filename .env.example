# Database Configuration
# Use DATABASE_URL=sqlite.db for local SQLite or postgresql://... for Neon Postgres
DATABASE_URL=sqlite.db
# Use STORAGE=db for persistence (recommended) or STORAGE=memory for volatile RAM storage
STORAGE=db

# Server Configuration
PORT=5000
NODE_ENV=development
# Host to bind to. Default: 127.0.0.1 in dev, 0.0.0.0 in production.
# HOST=0.0.0.0
# Admin API key used by admin endpoints (min 16 chars, no placeholders).
ADMIN_API_KEY=local_dev_dummy_admin_api_key
# Bearer token for POST /admin/domains/reload (M-3)
ADMIN_RELOAD_TOKEN=local_dev_dummy_reload_token
# Log level for structured logger (default: info)
# LOG_LEVEL=info
# Default guardrail profile for completions (strict|relaxed; default: relaxed)
# DEFAULT_GUARDRAIL_PROFILE=relaxed
# A-2: bigram overlap thresholds for groundedness pre-filter (default 0.2 / 0.5)
# GROUNDEDNESS_BIGRAM_LOW_THRESHOLD=0.2
# GROUNDEDNESS_BIGRAM_HIGH_THRESHOLD=0.5
# GROUNDEDNESS_DEGRADE_THRESHOLD=10

# === Resilience Budget (teto da cascata retry × fallback) ===
# Teto wall-clock global por request LLM e janela independente por estágio.
# Impede retry × fallback × timeout sem teto e preserva tempo real para fallback.
# Defaults: 120s no total e até 60s para cada primária/fallback.
REQUEST_BUDGET_MS=120000
# Spec 10039 T9 — amostras de self-consistency por julgamento (default 2; 3 = mais robusto/caro)
SELF_CONSISTENCY_N=2
REQUEST_STAGE_BUDGET_MS=60000
# Teto de tentativas TOTAIS na cascata inteira (não 3-por-nível sem limite).
# Default 6: primary(3) + 1 nível de fallback(3) = 6, depois aborta.
REQUEST_MAX_TOTAL_ATTEMPTS=6

# AI Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_SITE_URL=http://localhost:5000
OPENROUTER_APP_NAME=AiChatFlow1
OPENROUTER_MODEL_PRIMARY=deepseek/deepseek-v4-pro
OPENAI_API_KEY=your_openai_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
# Xiaomi MiMo (native key/endpoint) — pro-tier primary for PM/PO/Tech Lead.
# Falls back to deepseek/deepseek-v4-pro (via OpenRouter) if unset/unavailable.
XIAOMI_API_KEY=your_xiaomi_mimo_api_key_here
XIAOMI_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
XIAOMI_MODEL_PRO=mimo-v2.5-pro
# NVIDIA NIM API key (optional — enables nvidia provider in llm-client-manager)
# NVIDIA_API_KEY=your_nvidia_api_key_here
# AWS Bedrock bearer token (optional — enables Bedrock provider; auto-detected)
# AWS_BEARER_TOKEN_BEDROCK=your_aws_bearer_token_here
# Tencent TokenHub API key (optional — enables tencent provider in llm-client-manager)
# TENCENT_TOKENHUB_KEY=your_tencent_tokenhub_key_here

# === Model Routing Overrides ===
# Per-tier model overrides. Defaults are resolved from XIAOMI/OpenRouter config.
OPENAI_MODEL_FAST=deepseek/deepseek-v4-flash
OPENAI_MODEL_CAPABLE=deepseek/deepseek-v4-flash
OPENAI_MODEL_TECHNICAL=codestral-latest
# Nano/Mini tiers (optional — fall back to FAST/CAPABLE if unset)
# OPENAI_MODEL_NANO=deepseek/deepseek-v4-pro
# OPENAI_MODEL_MINI=deepseek/deepseek-v4-pro
# Spec 028 (T8): o validador de boot roda em ENFORCE por default — um id de
# modelo fora da allowlist derruba o boot. Use o opt-out abaixo só para subir com
# uma config sabidamente inválida (volta ao modo report, apenas loga):
# MODEL_CONFIG_ENFORCE=false
# Coarse-grained aliases (override entire tier groups)
# FAST_MODEL=deepseek/deepseek-v4-flash
# CAPABLE_MODEL=xiaomi/mimo-v2.5-pro
# CODE_MODEL=qwen/qwen3-coder-next
# CONTEXT_SUMMARIZATION_MODEL=deepseek/deepseek-v4-flash
# MISTRAL_MODEL=mistral-medium-3.5
# MISTRAL_MODEL_CODESTRAL=codestral-latest
# Agent-specific model overrides
# PRD_GENERATION_MODEL=xiaomi/mimo-v2.5-pro
# PRODUCT_MANAGER_MODEL=xiaomi/mimo-v2.5-pro
# AGENT_EVAL_JUDGE_MODEL=deepseek/deepseek-v4-pro
ROUTING_ECONOMIC_MODEL=mistral-small-2603
ROUTING_SAFE_MODEL=deepseek/deepseek-v4-flash

# === Model Registry & Discovery ===
# Model registry bridge (default: disabled; opt-in with 'true')
# MODEL_REGISTRY_ENABLED=false
# Cache TTL for model registry entries (default: 14400000 = 4h, clamped 60s–7d)
# MODEL_REGISTRY_CACHE_TTL_MS=14400000
# MR-06: Dynamic model discovery scheduler (default: DISABLED; opt-in with 'true')
# Discovery hits external provider APIs on a schedule and should not run
# without the user's explicit consent.
# MODEL_DISCOVERY_ENABLED=false
# Discovery polling interval (default: 86400000 = 24h, clamped 5min–7d)
# MODEL_DISCOVERY_INTERVAL_MS=86400000
# RESERVED — not consumed by the current runtime. Discovery never auto-promotes;
# validated candidates must be promoted through the explicit server workflow.
# MODEL_DISCOVERY_AUTO_PROMOTE=false
# Path to model families config JSON (default: config/model-families.json)
# MODEL_FAMILIES_CONFIG_PATH=config/model-families.json
# Auto-rollback when a model exceeds this failure threshold (default: 5)
# MODEL_ROLLBACK_THRESHOLD=5
# Cooldown before re-promoting a rolled-back model (default: 900000 = 15min)
# MODEL_ROLLBACK_COOLDOWN_MS=900000
# RESERVED — not consumed by the current runtime. Promotion currently performs
# one transactional attempt and reports the committed/post-commit result honestly.
# MODEL_PROMOTION_MAX_RETRIES=3

# === Tool Execution ===
# P2-01: Timeout in ms for each agent tool execution (default: 30000)
# Tool-specific `timeoutMs` declarations take precedence. Runtime accepts 1–300000.
# TOOL_TIMEOUT_MS=30000

# === Skill Fetcher ===
# P1-02: Max bytes to download from skill.sh URLs (default: 20000)
# SKILL_SH_MAX_BYTES=20000

# === Model Routing Budget ===
# Max attempts per stage in the routing cascade (default: 2)
# MODEL_ROUTING_MAX_ATTEMPTS_PER_STAGE=2
# Max fallbacks per demand across the whole cascade (default: 3)
# MODEL_ROUTING_MAX_FALLBACKS_PER_DEMAND=3

# === Cost-Aware Routing ===
# Master switch for cost-aware routing (default: enabled; set 'false' to disable)
# ROUTING_ENABLED=true
# Token threshold to trigger cost-aware routing (default: 600)
# ROUTING_TOKEN_THRESHOLD=600
# Kill-switch: multiplier threshold to trip cost kill-switch (default: 1.1)
# KILL_SWITCH_THRESHOLD=1.1

# === Rerank Configuration ===
# Dedicated Cohere cross-encoder through OpenRouter POST /api/v1/rerank.
# Disabled by default unless explicitly set to true in the local environment.
RERANK_ENABLED=false
RERANK_MODEL=cohere/rerank-v3.5
RERANK_TIMEOUT_MS=5000
# Current Cohere v3.5 list price per search; override when changing model.
RERANK_COST_PER_SEARCH_USD=0.002
# Max documents to send to rerank API (default: 15)
# RERANK_MAX_DOCS=15
# Max query chars for rerank (default: 2000)
# RERANK_MAX_QUERY_CHARS=2000
# Rerank cache TTL in ms (default: 600000 = 10 min)
# RERANK_CACHE_TTL_MS=600000
# Tridimensional rerank weights (default: 0.7 / 0.15 / 0.15; normalized if sum ≠ 1)
# RERANK_RELEVANCE_WEIGHT=0.7
# RERANK_DIVERSITY_WEIGHT=0.15
# RERANK_SALIENCE_WEIGHT=0.15

# === LLM Guardrails (Prompt Injection Defense) ===
# Master switch for LLM guardrails (default: enabled; set 'false' to disable)
# LLM_GUARDRAILS_ENABLED=true
# Semantic injection classifier — primary model (default: deepseek/deepseek-v4-flash)
# GUARDRAIL_INJECTION_MODEL=deepseek/deepseek-v4-flash
# Semantic injection classifier — fallback model (default: mistral-medium-3.5)
# GUARDRAIL_INJECTION_FALLBACK_MODEL=mistral-medium-3.5
# Max input chars for injection classifier (default: 4000)
# GUARDRAIL_INJECTION_MAX_CHARS=4000
# Primary classifier timeout (default: 2500ms)
# GUARDRAIL_INJECTION_TIMEOUT_MS=2500
# Fallback classifier timeout (default: 8000ms)
# GUARDRAIL_INJECTION_FALLBACK_TIMEOUT_MS=8000
# Fallback rate-limit (requests/min, default: 2 — Mistral free tier)
# GUARDRAIL_INJECTION_FALLBACK_RPM=2

# === LLM Audit & Logging ===
# LLM audit logging (default: enabled; set 'false' to disable)
# LLM_LOGS_ENABLED=true
# Bearer token required to access LLM audit/safety routes (default: empty = routes disabled)
# LLM_AUDIT_TOKEN=your_audit_token_here
# M4 dispatch log (default: enabled; set 'false' to disable)
# M4_DISPATCH_LOG_ENABLED=true

# === Rate Limiting (H-3) ===
# Per-IP rate limit for LLM-triggering endpoints (demand creation, refinement).
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=30

# === Response Logging (H-6) ===
# Log response bodies to console (default: false — leaks sensitive data).
# LOG_RESPONSE_BODY=false

# === Bedrock/OpenRouter Bridge ===
# Force OpenRouter even when Bedrock credentials exist (default: auto — uses OR if no Bedrock token)
# LLM_FORCE_OPENROUTER=false

# === Observability (OpenTelemetry) ===
# OTLP endpoint for trace export (Jaeger, SigNoz, Grafana Tempo).
# Default http://localhost:4318 funciona "as-is" com o stack local:
#   docker compose -f observability/docker-compose.observability.yml up -d
# (o Tempo do compose escuta na porta 4318 do host). Sem o stack rodando,
# o tracer em desenvolvimento tenta enviar e falha silenciosamente (non-blocking);
# em produção com localhost vira dryRun.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Optional OTLP headers (e.g., auth) — JSON or comma-separated key=value
# OTEL_EXPORTER_OTLP_HEADERS=
TRACE_EXPORT_BATCH_SIZE=20
TRACE_EXPORT_FLUSH_INTERVAL=5000
# Trace sampling rate 0.0–1.0 (default: 1.0 = all)
# TRACE_SAMPLE_RATE=1.0
# Always sample traces for errors (default: enabled; set 'false' to disable)
# TRACE_ALWAYS_SAMPLE_ERRORS=true
# Comma-separated priority operations to always sample (default: empty)
# TRACE_PRIORITY_OPERATIONS=
# Comma-separated priority agents to always sample (default: empty)
# TRACE_PRIORITY_AGENTS=
# RAG instrumentation sampling rate (0.0-1.0). Set <1.0 to reduce overhead.
# Default: 1.0 (all requests instrumented)
RAG_INSTRUMENTATION_SAMPLE_RATE=1.0
# Enable LLM metrics collection (default: false; set 'true' to enable)
# ENABLE_LLM_METRICS=false

# === Embedding Configuration ===
# Options: "auto", "openai", "openrouter", "local"
EMBEDDING_PROVIDER=openrouter
# Model: qwen/qwen3-embedding-8b via OpenRouter
OPENAI_EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# Optional cost tracking overrides, in USD per 1M tokens.
# Use these when the selected model is not in the built-in pricing map.
OPENAI_INPUT_COST_USD_PER_1M=
OPENAI_OUTPUT_COST_USD_PER_1M=

# === LLM Client Tuning ===
# Batch concurrency for OpenAI-compatible calls (default: 4)
# OPENAI_BATCH_CONCURRENCY=4
# Retry attempts for OpenAI-compatible calls (default: 3)
# OPENAI_RETRY_ATTEMPTS=3
# Wall-clock timeout for a single AI chat completion (default: 120000 = 2min)
AI_CHAT_TIMEOUT_MS=45000

# === Configurable Retry / Backoff (Spec 10259 T3) ===
# Max attempts, initial delay, exponential backoff multiplier and ceiling.
# Defaults: 3 attempts, 350ms initial, 2x multiplier, 10s ceiling.
# RETRY_MAX_ATTEMPTS=3
# RETRY_INITIAL_DELAY_MS=350
# RETRY_BACKOFF_MULTIPLIER=2
# RETRY_MAX_DELAY_MS=10000

# === A-1: AgentOrchestrator retry limit ===
# Max retries per agent execution (default 3).
# ORCHESTRATOR_AGENT_MAX_RETRIES=3

# === A-2: Worker Backoff Configuration ===
# Backoff base e teto por worker. Defaults: 5 retries, 200ms base, 5000ms teto.
# ORCHESTRATION_MAX_RETRIES=5
# ORCHESTRATION_BASE_BACKOFF_MS=50
# ORCHESTRATION_MAX_BACKOFF_MS=5000
# WORKER_BACKOFF_DOCUMENT=200
# WORKER_BACKOFF_DEMAND_GEN=200
# WORKER_MAX_RETRIES=5
# WORKER_MAX_BACKOFF_MS=5000

# === Caching ===
# AI response cache (default: enabled)
AI_RESPONSE_CACHE_ENABLED=true
AI_RESPONSE_CACHE_MAX_ENTRIES=250
AI_RESPONSE_CACHE_TTL_MS=1800000
# Unified similarity threshold for exact + semantic cache (0.0-1.0; default: 0.85)
AI_CACHE_THRESHOLD=0.85
# Enable/disable semantic cache. When false, SEMANTIC_CACHE_TTL_MS and SEMANTIC_CACHE_MAX_ENTRIES are ignored.
SEMANTIC_CACHE_ENABLED=true
# Semantic cache TTL in ms (default: 1800000 = 30 min)
SEMANTIC_CACHE_TTL_MS=1800000
# Semantic cache max entries (default: 250 — aligned with AI response cache)
SEMANTIC_CACHE_MAX_ENTRIES=250
# Cache key version (bump to invalidate all cache entries; default: cache-canonical-v2)
# CACHE_KEY_VERSION=cache-canonical-v2

# === Few-shot Configuration ===
# Directory containing curated few-shot datasets for agent prompts.
FEWSHOT_DATASET_DIR=datasets/few-shot
# Directory containing agent-specific few-shot prompt files.
FEWSHOT_AGENTS_DIR=agents

# === Redis (optional — distributed cache) ===
# Redis URL (optional; if unset, in-memory cache is used)
# REDIS_URL=redis://localhost:6379
# Redis connect timeout in ms (default: 3000)
# REDIS_CONNECT_TIMEOUT_MS=3000
# Redis key prefix (default: aichatflow:)
# REDIS_KEY_PREFIX=aichatflow:

# === Evolving Context ===
AI_USAGE_MAX_RECORDS=1000
EVOLVING_CONTEXT_TTL_MS=3600000
EVOLVING_CONTEXT_MAX_ENTRIES=100
# Teto duro do contexto final enviado aos agentes (~12k tokens por padrão).
EVOLVING_CONTEXT_MAX_CHARS=48000

# === Self-Improvement ===
# Slow turn threshold in ms for self-improvement pattern extraction (default: 30000)
# SELF_IMPROVEMENT_SLOW_TURN_MS=30000
# Divergence ratio threshold for self-improvement pattern extraction (default: 0.5)
# SELF_IMPROVEMENT_HIGH_DIVERGENCE_RATIO=0.5

# === Request Telemetry ===
# Task-type classification for telemetry (default: disabled; set 'true' to enable)
# CLASSIFICATION_ENABLED=false

# === Refinement Questions ===
# Interactive refinement questions (default: disabled; set 'true' to enable)
# REFINEMENT_INTERACTIVE_QUESTIONS_ENABLED=false
# Timeout for refinement question generation (default: 60000 = 1min)
# REFINEMENT_QUESTION_TIMEOUT_MS=60000

# === Retention Worker ===
# Background retention worker (default: disabled; set 'true' to enable)
# RETENTION_WORKER_ENABLED=false
# Retention sweep interval in hours (default: 24)
# RETENTION_WORKER_INTERVAL_HOURS=24

# === Phase 0 Discovery ===
# Phase 0 demand discovery (default: disabled; set 'true' to enable)
# PHASE0_DISCOVERY_ENABLED=false

# GitHub Configuration
# Use a fine-grained personal access token with read-only repository permissions:
# - Repository access: selected repositories or all repositories
# - Contents: Read-only
# - Metadata: Read-only
GITHUB_ACCESS_TOKEN=your_fine_grained_read_only_github_token_here
GITHUB_TOKEN=your_fine_grained_read_only_github_token_here
# Write token (fine-grained PAT) for committing files and opening pull requests.
# Use ONLY on a disposable sandbox repository; never commit the real value.
# GITHUB_WRITE_TOKEN=your_fine_grained_write_github_token_here
# Bounded GitHub code-search pagination (defaults: 3 pages / 200 unique paths).
# Valid ranges enforced by runtime: pages 1–10, results 1–500.
# GITHUB_SEARCH_MAX_PAGES=3
# GITHUB_SEARCH_MAX_RESULTS=200

# === Agent Tools Configuration ===
# Global kill-switch for all agent tools (default: enabled if tools exist)
AGENT_TOOLS_ENABLED=true
# Per-agent feature flags (default: enabled if agent has registered tools)
# Set to false to disable tools for specific agents
TECH_LEAD_TOOLS_ENABLED=true
PRODUCT_MANAGER_TOOLS_ENABLED=true
QA_TOOLS_ENABLED=true
SCRUM_MASTER_TOOLS_ENABLED=true
# Show tool call trailer in agent responses (default: true)
AGENT_TOOLS_TRAILER=true

# === DocuMente Integration (H-24) ===
# API key for DocuMente external export (required for epic/user-stories export)
# DOCUMENTE_API_KEY=your_documente_api_key_here
# Single DocuMente URL for health probing (fallback if DOCUMENTE_URLS is unset)
# DOCUMENTE_URL=http://localhost:5000
# Comma-separated list of DocuMente URLs for health probing
# (default: http://localhost:3000,http://localhost:5000,http://localhost:5173,http://localhost:5174)
# DOCUMENTE_URLS=http://localhost:5000
# Client-side DocuMente URL (exposed to browser via Vite; prefix VITE_)
# VITE_DOCUMENTE_URL=http://localhost:5000

# === RAG / Refinement ===
# Minimum similarity threshold for refinement RAG (default: 0.7)
# REFINEMENT_RAG_MIN_SIMILARITY=0.7

# === Context Builder Cache ===
# Enable context summarization cache (default: true; set 'false' to disable)
# CONTEXT_CACHE_ENABLED=true

# === Code Agent Configuration (H-24) ===
# Auto-run code agent after speckit validation (default: false)
# AGENT_AUTORUN_ENABLED=false
# Override path for the technical debt register (default: TECHNICAL_DEBT.md in repo root)
# TECH_DEBT_PATH=TECHNICAL_DEBT.md
# Code agent execution timeout in ms (default: 300000 = 5 min)
# AGENT_TIMEOUT_MS=300000
# Typecheck command for code agent (default: npx tsc --noEmit)
# AGENT_TYPECHECK_CMD=npx tsc --noEmit
# CLI binary for code agent (default: claude)
# AGENT_CLI_BIN=claude
# CLI args for code agent (default: empty)
# AGENT_CLI_ARGS=
# Stream JSON output from CLI (default: false)
# AGENT_CLI_STREAM_JSON=false

# === Codex Agent (Optional) ===
# API key for Codex agent adapter (required if using Codex)
# CODEX_API_KEY=your_codex_api_key_here
# Base URL for Codex API (default: https://api.openai.com/v1)
# CODEX_BASE_URL=https://api.openai.com/v1
# Model for Codex agent (required if using Codex)
# CODEX_MODEL=o3

# === Schema Health (H-24) ===
# Set to 'strict' to throw on schema drift in production (default: warn only)
# SCHEMA_VERIFY_DEPLOYED=warn

# === OpenRouter Balance Monitoring (H-24) ===
# Low balance threshold in USD for OpenRouter alerts (default: 5.0)
# OPENROUTER_LOW_BALANCE_USD=5.0

# === Env Audit Scripts ===
# Optional root directory for check-env-sync.sh (default: current working dir)
# CHECK_ENV_SYNC_ROOT=

# === Plataforma Pública / Vibe Coders (demanda #10358) ===
# Camada multi-tenant aditiva — ver constituição v1.1.0, "Camada de Plataforma
# Pública". Segredos abaixo têm placeholders de exemplo; troque por valores
# fortes (min 16 chars, sem placeholder conhecido) antes de usar em produção.
# Secret para assinar/validar JWTs de sessão (signup/login) e o `state` do
# fluxo OAuth do GitHub. Nunca reutilize o ADMIN_API_KEY aqui.
JWT_SECRET=change_this_to_a_long_random_dev_only_secret
# Secret para cifrar (AES-256-GCM) o access token OAuth do GitHub em repouso.
GIT_TOKEN_SECRET=change_this_to_a_long_random_dev_only_secret_too
# GitHub OAuth App (criado pelo proprietário do repositório em
# https://github.com/settings/developers) — necessário para T4 funcionar
# ponta a ponta. Sem isto configurado, /api/git/auth/github retorna 500.
GITHUB_OAUTH_CLIENT_ID=your_github_oauth_app_client_id_here
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_app_client_secret_here
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5000/api/git/auth/github/callback
# Limites do Free Tier (Fatia 1) — default conforme consenso do PRD/Tasks.md.
# FREE_TIER_MAX_REFINEMENTS_PER_MONTH=3
# FREE_TIER_MAX_CONNECTED_REPOS=1
# Demanda #10364 (Fatia 2A) — limites do Pro Tier + Paddle (Merchant of Record).
# PRO_TIER_MAX_REFINEMENTS_PER_MONTH=30
# PRO_TIER_MAX_CONNECTED_REPOS=0  # 0 = ilimitado
# PADDLE_API_KEY=your_paddle_api_key_here
# PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret_here
# VITE_PADDLE_VENDOR_ID=your_paddle_vendor_id
# VITE_PADDLE_PRICE_ID=pro_12345  # price_id configurado no dashboard do Paddle
# VITE_PADDLE_ENVIRONMENT=sandbox  # sandbox | production
