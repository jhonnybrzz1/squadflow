{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@10.8.2",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "node scripts/dev.mjs",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist --alias:@shared=./shared",
    "start": "NODE_ENV=production node dist/index.js",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 4173",
    "check": "tsc",
    "typecheck": "tsc --noEmit",
    "turbo:build": "turbo run build",
    "turbo:typecheck": "turbo run typecheck",
    "db:push": "drizzle-kit push",
    "test": "vitest run",
    "check:transitions": "node scripts/check-transitions.js",
    "rag:ingest:refinements": "tsx scripts/ingest-refinement-rag.ts",
    "rag:embed:refinements": "tsx scripts/generate-refinement-embeddings.ts",
    "rag:backfill:repos": "tsx scripts/backfill-repo-full-name.ts",
    "rag:coverage": "tsx scripts/rag-coverage.ts",
    "audit:agents": "tsx scripts/agent-audit-sample.ts",
    "validate:agents": "tsx scripts/validate-agents.ts",
    "test:openai": "tsx server/test-openai.ts",
    "test:multi-model": "tsx server/test-multi-model.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:e2e:reduced-motion": "playwright test tests/a11y/reduced-motion.spec.ts",
    "prompts:baseline": "tsx scripts/prompts-baseline.ts",
    "prompts:list": "tsx scripts/prompts-list.ts",
    "prompts:test": "tsx scripts/prompts-test.ts",
    "prompts:fewshot:score": "tsx scripts/score-fewshot.ts",
    "evaluate-prompt": "tsx server/evaluation/evaluate-prompt.ts",
    "evaluate-prompt:compare": "node scripts/compare-eval-baseline.js",
    "evaluate-agent": "tsx server/evaluation/evaluate-agent.ts",
    "evaluate-guardrails": "tsx server/evaluation/evaluate-guardrails.ts",
    "evaluate-rag": "tsx server/evaluation/evaluate-rag.ts",
    "evaluate-rag:generation": "source .venv-ragas/bin/activate && python3 scripts/evaluate-generation.py",
    "evaluate-routing": "tsx server/evaluation/evaluate-routing.ts",
    "classifier:f1:baseline": "tsx scripts/classifier-f1-baseline.ts",
    "gates": "node scripts/validate-gates.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=moderate",
    "validate:public": "bash scripts/validate-public-repo.sh",
    "verify:findings": "tsx scripts/verify-findings.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@hookform/resolvers": "^3.10.0",
    "@neondatabase/serverless": "^0.10.4",
    "@octokit/plugin-retry": "^8.1.0",
    "@octokit/plugin-throttling": "^11.0.3",
    "@octokit/rest": "^22.0.1",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tanstack/react-query": "^5.60.5",
    "@types/dompurify": "^3.0.5",
    "@types/multer": "^2.0.0",
    "@uiw/react-md-editor": "^4.0.11",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.13",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.7.0",
    "express": "^4.22.2",
    "framer-motion": "^12.40.0",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.3.1",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.453.0",
    "mermaid": "^11.16.1",
    "multer": "^2.2.0",
    "mysql2": "^3.23.3",
    "next-themes": "^0.4.6",
    "openai": "^6.34.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.55.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.2",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "simple-git": "^3.36.0",
    "swagger-ui-express": "^5.0.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^14.0.0",
    "validator": "^13.15.35",
    "winston": "^3.19.0",
    "wouter": "^3.3.5",
    "ws": "^8.21.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@replit/vite-plugin-cartographer": "^0.2.7",
    "@replit/vite-plugin-runtime-error-modal": "^0.0.3",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.12.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.5.0",
    "axe-core": "^4.11.4",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-a11y": "^1.3.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "playwright": "^1.60.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.17",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.1",
    "turbo": "^2.10.8",
    "typescript": "~5.6.3",
    "vite": "^7.3.3",
    "vitest": "^4.1.5"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  }
}
