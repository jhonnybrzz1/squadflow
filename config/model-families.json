      "includePatterns": ["^mimo-v\\d+(?:\\.\\d+)*-pro$"],
      "excludePatterns": ["ultraspeed", "preview", "beta", "experimental", "free"],
      "minimumContextLength": 131072,
      "requiredInputModalities": ["text"],
      "comparisonStrategy": "semantic-version",
      "autoPromote": false
    },
